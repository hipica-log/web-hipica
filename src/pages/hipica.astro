---
import Layout from '~/layouts/PageLayout.astro';
import hipicaImage from '~/assets/images/hipica-deporte.png';

const metadata = {
  title: 'Hípica',
  description: 'Información sobre la actividad ecuestre de la Hípica de Logroño.',
};
---

<Layout metadata={metadata}>
  <section class="bg-[#f4f2e9] px-5 py-14 sm:px-8 sm:py-20 lg:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-[#a77b17]">Hípica de Logroño</p>
        <h1 class="text-4xl font-extrabold tracking-tight text-[#234a68] sm:text-5xl">Actividad ecuestre</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#52616d]">
          La actividad de hípica del Centro está dirigida por Servicios Ecuestres Rioja SL y gestionada por Patricia.
        </p>
        <div class="mt-6 rounded-lg bg-white p-6 shadow-sm ring-1 ring-black/5">
          <h2 class="text-xl font-bold text-[#234a68]">Horarios de atención</h2>
          <p class="mt-3 leading-relaxed text-[#52616d]">De lunes a viernes, de 10:00 a 14:00 y de 17:00 a 20:00.</p>
          <p class="mt-1 leading-relaxed text-[#52616d]">Sábados, de 10:00 a 14:00.</p>
          <div class="mt-4 flex flex-col items-start gap-2 text-[#234a68]">
            <a class="font-semibold underline underline-offset-4 hover:text-[#9a7010]" href="tel:635699178">Teléfono: 635 699 178</a>
            <a class="font-semibold underline underline-offset-4 hover:text-[#9a7010]" href="https://wa.me/34635699178">Contactar por WhatsApp</a>
            <a class="font-semibold underline underline-offset-4 hover:text-[#9a7010]" href="mailto:serviciosecuestresrioja@gmail.com">serviciosecuestresrioja@gmail.com</a>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#dfb23e] px-6 py-3 font-bold text-[#234a68] transition hover:bg-[#edc85e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234a68]"
          >
            Contacto
          </a>
          <a
            href="/instalaciones"
            class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-[#234a68]/70 px-6 py-3 font-semibold text-[#234a68] transition hover:bg-[#234a68] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234a68]"
          >
            Ver instalaciones
          </a>
        </div>
      </div>
      <img
        src={hipicaImage.src}
        alt="Jinete practicando doma clásica con un caballo en una pista exterior"
        class="w-full rounded-xl shadow-lg"
        width={hipicaImage.width}
        height={hipicaImage.height}
        loading="eager"
      />
    </div>
  </section>
</Layout>
