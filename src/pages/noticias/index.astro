---
import Layout from '../../layouts/Layout.astro';

const entries = Object.entries(import.meta.glob('../../data/noticias/*.md', { eager: true }))
	.map(([path, module]) => ({ ...module.frontmatter, slug: path.split('/').pop()?.replace(/\.md$/, '') }))
	.sort((a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime());
---
<Layout title="Actualidad | Hípica Militar de Logroño" description="Noticias, avisos y eventos de la Hípica Militar de Logroño.">
	<main class="page">
		<a class="back" href="/">← Volver al inicio</a>
		<p class="eyebrow">LO QUE PASA EN EL CLUB</p>
		<h1>Actualidad<br /><em>de la Hípica.</em></h1>
		{entries.length ? <div class="list">{entries.map((entry) => <a class="news-card" href={`/noticias/${entry.slug}/`}>
			{entry.thumbnail ? <img src={entry.thumbnail} alt="" loading="lazy" /> : <span class="card-placeholder" aria-hidden="true">HML</span>}
			<div class="card-copy"><span class="meta">{entry.category ?? 'Actualidad'}{entry.date ? ` · ${new Date(entry.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}` : ''}</span><h2>{entry.title}</h2><span class="read-more">Leer noticia <b aria-hidden="true">↗</b></span></div>
		</a>)}</div> : <p class="empty">Todavía no hay noticias publicadas. Vuelve pronto.</p>}
	</main>
</Layout>
<style>
	:global(:root){--ink:#24372c;--paper:#fbfaf6;--rust:#b96b46;--muted:#77796e}:global(body){background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;margin:0}.page{max-width:1260px;padding:44px 7% 110px;margin:auto;min-height:70vh}.back{display:inline-flex;align-items:center;color:var(--ink);text-decoration:none;font-size:11px;margin:0 0 70px;padding:11px 14px;border:1px solid #d7d3c7}.back:hover{color:var(--rust)}.eyebrow{font-size:9px;letter-spacing:2px;color:var(--muted)}.page h1{font:normal clamp(50px,8vw,88px)/.98 Georgia,serif;letter-spacing:-2px;margin:18px 0 58px}.page h1 em{font-weight:normal;color:var(--rust)}.list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.news-card{display:flex;flex-direction:column;color:var(--ink);text-decoration:none;background:#fffefa;border:1px solid #e5e1d5;overflow:hidden;transition:transform .2s ease,box-shadow .2s ease}.news-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px #26352b18}.news-card img,.card-placeholder{display:grid;width:100%;height:220px;object-fit:cover;background:#e8e6dc}.card-placeholder{place-items:center;background:linear-gradient(135deg,#354a3c,#1f3027);color:#e7d9b9;font:italic 34px Georgia,serif}.card-copy{padding:21px;display:flex;flex:1;flex-direction:column;align-items:start}.meta{font-size:9px;letter-spacing:.9px;text-transform:uppercase;color:var(--muted)}.card-copy h2{font:normal 25px/1.2 Georgia,serif;margin:13px 0 24px}.read-more{font-size:10px;margin-top:auto;padding-bottom:5px;border-bottom:1px solid #c8c4b8}.read-more b{color:var(--rust);margin-left:10px}.empty{color:var(--muted);font:22px Georgia,serif;padding:24px 0;border-top:1px solid #d8d7cc;border-bottom:1px solid #d8d7cc}
	@media(max-width:850px){.list{grid-template-columns:repeat(2,minmax(0,1fr))}.page{padding-left:6%;padding-right:6%}}
	@media(max-width:560px){.page{padding:28px 6% 76px}.back{margin-bottom:52px}.page h1{font-size:clamp(48px,13vw,65px);margin-bottom:36px}.list{grid-template-columns:1fr;gap:14px}.news-card img,.card-placeholder{height:clamp(190px,58vw,280px)}}
</style>
