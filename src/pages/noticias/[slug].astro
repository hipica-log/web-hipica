---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
	const modules = import.meta.glob('../../data/noticias/*.md', { eager: true });
	return Object.entries(modules).map(([path, entry]) => ({
		params: { slug: path.split('/').pop()?.replace(/\.md$/, '') },
		props: { entry },
	}));
}
const { entry } = Astro.props;
const { Content } = entry;
const { title, date, category, thumbnail } = entry.frontmatter;
---
<Layout title={`${title} | Hípica Militar de Logroño`} description={title}>
	<main class="article">
		<a class="back" href="/noticias/">← Todas las noticias</a>
		{thumbnail && <img class="cover" src={thumbnail} alt="" />}
		<p class="eyebrow">{category ?? 'Actualidad'}{date ? ` · ${new Date(date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}` : ''}</p>
		<h1>{title}</h1>
		<div class="prose"><Content /></div>
	</main>
</Layout>
<style>
	:global(:root){--ink:#24372c;--paper:#fbfaf6;--rust:#b96b46;--muted:#77796e}:global(body){background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;margin:0}.article{max-width:900px;margin:auto;padding:42px 30px 110px;min-height:70vh}.back{display:inline-flex;color:var(--ink);text-decoration:none;font-size:11px;margin-bottom:36px;padding:11px 14px;border:1px solid #d7d3c7}.back:hover{color:var(--rust)}.cover{display:block;width:100%;max-height:520px;aspect-ratio:16/9;object-fit:cover;margin-bottom:40px;border-radius:2px}.eyebrow{font-size:9px;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase}.article h1{font:normal clamp(42px,7vw,74px)/1.04 Georgia,serif;letter-spacing:-1.5px;margin:18px 0 36px}.prose{font-size:16px;line-height:1.9;color:#555d53;max-width:700px}.prose :global(h2),.prose :global(h3){font:normal 30px Georgia,serif;color:var(--ink);margin-top:36px}.prose :global(img){max-width:100%;height:auto}.prose :global(a){color:#a55838}
	@media(max-width:560px){.article{padding:24px 6% 76px}.back{margin-bottom:27px}.cover{aspect-ratio:4/3;margin-bottom:30px}.article h1{font-size:clamp(40px,11vw,58px);margin-bottom:27px}.prose{font-size:15px}}
</style>
