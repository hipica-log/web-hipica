---
import Layout from '~/layouts/Layout.astro';
import whatsappChannelImage from '~/assets/images/canal-whatsapp.png';

// Página de entrada temporal. La portada completa está conservada en /inicio-completo.
const whatsappChannelUrl = 'https://whatsapp.com/channel/0029VbDTo95LdQefCExaz20q';

const metadata = {
  title: 'Hípica de Logroño',
  description: 'Síguenos en el canal de WhatsApp de la Hípica de Logroño.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="flex min-h-screen w-full items-center justify-center bg-[#234a68] px-5 py-12 text-white">
    <div class="mx-auto flex w-full max-w-5xl flex-col items-center gap-10 text-center md:flex-row md:justify-between md:gap-16 md:text-left">
      <div class="max-w-xl">
        <p class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-[#e0b23b]">Logroño · La Rioja</p>
        <h1 class="text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          Hípica de Logroño
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-white/80 sm:text-xl">
          Síguenos para estar al día de las novedades.
        </p>
        <a
          href={whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex min-h-14 items-center justify-center rounded-md bg-[#1fbd61] px-8 py-4 text-lg font-bold text-white transition hover:bg-[#19a955] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Canal de WhatsApp
        </a>
      </div>

      <a
        href={whatsappChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl bg-white p-3 shadow-2xl shadow-black/25 transition hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e0b23b]"
        aria-label="Abrir el canal de WhatsApp de la Hípica de Logroño"
      >
        <img
          src={whatsappChannelImage.src}
          alt="Código QR del canal de WhatsApp de la Hípica de Logroño"
          class="h-auto w-64 rounded-lg sm:w-80"
          width={whatsappChannelImage.width}
          height={whatsappChannelImage.height}
        />
      </a>
    </div>
  </main>
</Layout>
