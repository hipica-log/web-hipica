---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(30 61 46);
    --aw-color-secondary: rgb(42 83 61);
    --aw-color-accent: rgb(223 178 62);

    --aw-color-text-heading: rgb(30 61 46);
    --aw-color-text-default: rgb(39 53 45);
    --aw-color-text-muted: rgb(39 53 45 / 70%);
    --aw-color-bg-page: rgb(244 242 233);

    --aw-color-bg-page-dark: rgb(30 61 46);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(223 178 62);
    --aw-color-secondary: rgb(237 200 94);
    --aw-color-accent: rgb(223 178 62);

    --aw-color-text-heading: rgb(247 246 239);
    --aw-color-text-default: rgb(229 233 225);
    --aw-color-text-muted: rgb(229 233 225 / 72%);
    --aw-color-bg-page: rgb(30 61 46);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
