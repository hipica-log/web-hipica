---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
  {
    posts.map((post) => (
      <li class="min-w-0">
        <Item post={post} />
      </li>
    ))
  }
</ul>
