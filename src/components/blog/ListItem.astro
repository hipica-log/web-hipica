---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="flex min-h-56 overflow-hidden rounded-lg bg-[#f4f2e9] shadow-sm ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-md">
  {
    image ? (
      <a href={link || undefined} class="relative block w-[36%] shrink-0 self-stretch overflow-hidden" aria-label={`Leer ${post.title}`}>
        <Image
          src={image}
          alt={post.imageAlt || post.title}
          class="absolute inset-0 h-full w-full object-cover"
          layout="cover"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <div class="flex w-[36%] shrink-0 items-center justify-center self-stretch bg-[#dce3e8] text-4xl text-[#234a68]/60" aria-hidden="true">
        ✦
      </div>
    )
  }
  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-[#647381]">
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
      {post.category && (
        <>
          <span aria-hidden="true">·</span>
          <a class="hover:underline" href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>
        </>
      )}
    </div>
    <h2 class="mt-2 text-lg font-bold leading-tight text-[#234a68]">
      {link ? <a class="hover:underline" href={link}>{post.title}</a> : post.title}
    </h2>
    {post.excerpt && <p class="mt-2 line-clamp-4 text-sm leading-relaxed text-[#52616d]">{post.excerpt}</p>}
    {link && (
      <a
        href={link}
        class="mt-auto inline-flex items-center pt-4 text-sm font-semibold text-[#234a68] underline decoration-[#234a68]/50 underline-offset-4 hover:decoration-[#234a68]"
      >
        Leer noticia <span class="ml-1" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>
